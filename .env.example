# Local Docker Compose configuration. Generate secrets: ./scripts/local.sh init
APP_PORT=8080
ENVIRONMENT=development
DEBUG=false

DB_USER=postgres
DB_PASSWORD=
AUTH_DB_NAME=auth_db
SCHEDULE_DB_NAME=schedule_db
TECHCARD_DB_NAME=techcard_db
# Optional host port with docker-compose.debug.yml. Internal DB port is always 5432.
DB_PUBLISHED_PORT=5432

SECRET_KEY=
INTERNAL_API_TOKEN=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Get the token from https://dashboard.ngrok.com/get-started/your-authtoken
# Store it only in .env. Frontend uses relative /api URLs on the tunnel domain.
NGROK_AUTHTOKEN=
NGROK_INSPECT_PORT=4040
