# Server Configuration
SERVER_IP=your_server_ip_here

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Database Names
AUTH_DB_NAME=auth_db
DB_NAME=schedule_db
TECHCARD_DB_NAME=techcard_db

# Security
SECRET_KEY=your_super_secret_key_here_minimum_32_characters

# Внутренний токен для межсервисных вызовов (аудит и т.п.)
# Обязателен: без него внутренние endpoint'ы возвращают 503.
INTERNAL_API_TOKEN=change_me_internal_token

# Время жизни токенов
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Environment
ENVIRONMENT=production
DEBUG=false

# CORS Settings (обновите для sslip.io)
ALLOWED_ORIGINS=http://your_server_ip.sslip.io,http://localhost:3000

# Service URLs (для внутренней коммуникации между контейнерами)
# Используем внутренние порты контейнеров (8000), а не внешние
AUTH_SERVICE_URL=http://auth:8000
SCHEDULE_SERVICE_URL=http://schedule:8000
TECHCARD_SERVICE_URL=http://techcard:8000
