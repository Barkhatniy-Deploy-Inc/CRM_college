# .env.example для Techcard сервиса
# Пример конфигурации для разработки и production

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
TECHCARD_DB_NAME=techcard_db
DB_USER=postgres
DB_PASSWORD=your_secure_password

# CORS Settings (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-domain.com

# Environment
ENVIRONMENT=development
DEBUG=true

# Application Settings
APP_NAME=Techcard API
APP_VERSION=1.0.0